# ============================================================
# Photonect News — Tier 3 Automation secrets
# Copy to .env and fill in. NEVER commit the real .env.
# ============================================================

# --- Instagram / Meta Graph API ---
# Get these via: developers.facebook.com -> My Apps -> Create App (type: Business)
# Long-lived user token: https://developers.facebook.com/tools/explorer
# IG Business Account ID: GET /me/accounts -> find @photonect.news page -> instagram_business_account.id
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_USER_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- TikTok Content Posting API ---
# Requires approved app at developers.tiktok.com
# After OAuth, store user access token + refresh token
# Scope required: video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_USER_ACCESS_TOKEN=
TIKTOK_USER_REFRESH_TOKEN=
TIKTOK_USER_OPEN_ID=

# --- Cloudinary (public CDN host — IG+TikTok need public video URL) ---
# Free tier: 25GB storage, 25GB bandwidth/month -> more than enough for 12 reels/day
# Sign up at cloudinary.com -> Dashboard shows these values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Runtime ---
POSTS_DIR=../data/posts
STATE_FILE=./state/posted.json
# Cadence: cron expression. Default = every 2h on the hour.
POST_CRON=0 */2 * * *
# Dry run = render + upload but don't actually post. Useful for testing.
DRY_RUN=false
